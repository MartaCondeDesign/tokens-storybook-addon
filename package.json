{
  "name": "tokens-storybook-addon",
  "version": "0.1.0",
  "private": false,
  "description": "Storybook addon that shows component token lists in the manager UI",
  "keywords": ["storybook", "storybook-addon", "design-tokens", "design-system"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MartaCondeDesign/tokens-storybook-addon.git"
  },
  "bugs": {
    "url": "https://github.com/MartaCondeDesign/tokens-storybook-addon/issues"
  },
  "homepage": "https://github.com/MartaCondeDesign/tokens-storybook-addon#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
